{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/server/index.ts",
    "index.html",
    "scripts/*.ts",
    "vite.config.ts",
    "eslint.config.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": [
    "@google/genai",
    "@hono/node-server",
    "hono",
    "dotenv",
    "lucide-react",
    "motion",
    "@eslint/compat",
    "autoprefixer"
  ],
  "ignoreExportsUsedInFile": true
}
