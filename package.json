{
  "name": "co-watcher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.2.5",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "bun src/server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "knip:prod": "knip --strict --production",
    "check:suppressions": "bun scripts/check-suppressions.ts",
    "check:metrics": "bun scripts/check-metrics.ts",
    "check:tokens": "bun scripts/check-design-tokens.ts",
    "check:styles": "bun scripts/check-arbitrary-styles.ts",
    "check:all": "bun run typecheck && bun run lint && bun run knip && bun run check:suppressions && bun run check:metrics && bun test",
    "ci": "bun run check:all && bun run knip:prod && bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "i18next": "^26.4.2",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  }
}
